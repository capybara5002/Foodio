# Local dev default:
# Leave VITE_API_URL empty so the Vite dev server proxies /api and /hubs.
# This works from phones over LAN/dev tunnels because the browser calls the same frontend origin.
VITE_API_URL=
VITE_PROXY_API_TARGET=http://localhost:5000
VITE_GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com

# Production/separate backend example:
# VITE_API_URL=https://your-foodio-api.example.com
